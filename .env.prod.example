# Production environment (config.settings.prod)
# =========================================
# Copy to .env.prod (git-ignored) and fill in real values. Never commit it:
#
#   copy .env.prod.example .env.prod
#
# Values below are the defaults the production settings expect.
DEBUG=False

# Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=
# Comma-separated hostnames, without scheme: shop.example.com,www.example.com
ALLOWED_HOSTS=
# Scheme + host of the public site, used for CSRF: https://shop.example.com
CSRF_TRUSTED_ORIGINS=

# HTTPS hardening. Keep the defaults behind a TLS-terminating proxy; set
# SECURE_SSL_REDIRECT=False only for a plain-HTTP tunnel.
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
DJANGO_LOG_LEVEL=INFO

# API rate limits (DRF throttling), e.g. 60/min, 1200/hour, 10/min
# ==============================================================
DRF_THROTTLE_ANON=120/min
DRF_THROTTLE_USER=600/min
DRF_THROTTLE_LOGIN=10/min
DRF_THROTTLE_REGISTER=20/hour

# Password attempts on /accounts/login/ and /admin/login/ (plain Django views)
LOGIN_ATTEMPT_RATE=10/min

# Reverse proxies allowed to set X-Forwarded-For, as IPs or CIDR ranges.
# Fill this in, otherwise every visitor is seen as the proxy and one attacker
# can rate-limit all users.
# NOTE: with the stack in docker-compose.prod.yml the web container does NOT see
# the proxy as 127.0.0.1 — it sees the Docker bridge gateway, so list the bridge
# network (check it with `docker network inspect bridge` or `ip route`).
# Examples: 172.16.0.0/12, 172.18.0.0/16, 10.0.0.5
TRUSTED_PROXY_IPS=

# Shared cache directory for rate-limit counters. Must be writable by the
# container user, and shared by all gunicorn workers.
CACHE_DIR=/tmp/django-cache

# Settings module used inside the container.
DJANGO_SETTINGS_MODULE=config.settings.prod

# Database (host "db" is the compose service name, not localhost)
# ==============================================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=final3
DATABASE_URL=postgres://postgres:POSTGRES_PASSWORD@db:5432/final3

# Gunicorn (started by docker-compose.prod.yml)
# ============================================
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=60

# Collect static files into STATIC_ROOT on start (WhiteNoise serves them).
COLLECTSTATIC=1

# Demo data is never seeded in production: keep this at 0, otherwise the shop
# starts with admin/<DJANGO_SEED_ADMIN_PASSWORD> plus fake products, orders and
# reviews. DJANGO_SEED_* are intentionally absent here: they only matter for
# local development (.env.dev), where compose turns seeding on.
SEED_DATA=0

# First superuser for /admin/ - production ships with an empty database, so
# there is nobody to log in as until you create one. Once, on the server:
#
#   docker compose -f docker-compose.prod.yml exec web python manage.py createsuperuser
#
# Without a TTY, pass the values through the environment instead:
#
#   docker compose -f docker-compose.prod.yml run --rm \
#     -e DJANGO_SUPERUSER_USERNAME=admin \
#     -e DJANGO_SUPERUSER_EMAIL=admin@example.com \
#     -e DJANGO_SUPERUSER_PASSWORD='<strong-password>' \
#     web python manage.py createsuperuser --noinput
#
# Store the password in GitHub Secrets (Settings -> Environments -> production)
# rather than typing it into a shell history.
# DJANGO_SUPERUSER_USERNAME=
# DJANGO_SUPERUSER_EMAIL=
# DJANGO_SUPERUSER_PASSWORD=

# Shop identity
# =============
SHOP_NAME=Brew & Barrel
SHOP_CURRENCY=USD
SHOP_EMAIL=

# Email notifications (Resend REST API)
# ====================================
# Without RESEND_API_KEY order confirmations are skipped, not sent.
RESEND_API_KEY=
RESEND_FROM_EMAIL=orders@example.com

# Local development (config.settings.local)
# ==========================================
# Optional: if this file is missing, the project runs on SQLite defaults.
DEBUG=True
SECRET_KEY=
DATABASE_URL=postgres://postgres:POSTGRES_PASSWORD@localhost:5432/final3


# Email notifications (Resend)
# ============================
# Without RESEND_API_KEY, emails are skipped and logged (dev/tests still work).
RESEND_API_KEY=
RESEND_FROM_EMAIL=orders@example.com
# Shop copy of order confirmations; empty disables the copy.
SHOP_EMAIL=


# Docker Compose interpolation (.env)
# ===================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=final3
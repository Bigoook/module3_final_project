# Local development (config.settings.local)
# ==========================================
# Optional: if this file is missing, the project runs on SQLite defaults.
DEBUG=True
SECRET_KEY=
DATABASE_URL=postgres://postgres:POSTGRES_PASSWORD@localhost:5432/final3


# Email notifications (Resend)
# ============================
# Without RESEND_API_KEY, emails are skipped and logged (dev/tests still work).
RESEND_API_KEY=
RESEND_FROM_EMAIL=orders@example.com
# Shop copy of order confirmations; empty disables the copy.
SHOP_EMAIL=


# Docker Compose interpolation (.env)
# ===================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=final3

# Docker Compose web service (config.settings.local inside the container)
# ======================================================================
# Note: inside the Compose network the DB host is "db", not "localhost".
# Copy this file to .env.dev (git-ignored) and fill in your own values:
#   copy .env.example .env.dev
DJANGO_SETTINGS_MODULE=config.settings.local
DATABASE_URL=postgres://postgres:POSTGRES_PASSWORD@db:5432/final3

# Passwords for `manage.py seed_data` (docker-entrypoint.sh runs it when
# SEED_DATA=1). They apply only when the account is created: an existing user
# keeps its password, so use `manage.py changepassword` to rotate it.
DJANGO_SEED_ADMIN_PASSWORD=
DJANGO_SEED_DEMO_PASSWORD=

# Production (config.settings.prod)
# ================================
# Production has its own template with every required key:
#   copy .env.prod.example .env.prod
# Only SECRET_KEY, ALLOWED_HOSTS and DATABASE_URL are mandatory; the rest have
# safe defaults (HTTPS hardening, gunicorn tuning, log level).
# `.env.prod` stays git-ignored, and CI/CD reads the same values from GitHub
# Secrets (Settings -> Environments -> production).